# Dr. Yamith Cuello — Frontend (yamith-fe). Copiar a .env.local.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analítica (F1). Vacío en local = no se carga.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
# Meta Ads: ID del Pixel (Administrador de eventos). Sólo se carga en el sitio público.
NEXT_PUBLIC_META_PIXEL_ID=

# Verificación de propiedad: Google Search Console y dominio en Meta Business.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# Continuar con Google (mismo ID de cliente OAuth que GOOGLE_CLIENT_ID del backend).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Borradores visuales (/demo). En producción quedan ocultos salvo DEMO_ENABLED=true.
DEMO_ENABLED=
